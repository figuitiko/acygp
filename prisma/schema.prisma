generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConstanciaStatus {
  VALID
  REVOKED
}

model Constancia {
  id             String           @id @default(cuid())
  folio          String           @unique
  validationHash String           @unique
  recipientName  String
  courseName     String
  standardCode   String?
  issuedAt       DateTime
  status         ConstanciaStatus @default(VALID)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([issuedAt])
}


enum EvaluationFormStatus {
  UNMAPPED
  ACTIVE
}

enum EvaluationSubmissionWorkflow {
  AWAITING_MAPPING
  PENDING_REVIEW
  REVIEWED
}

enum EvaluationOutcome {
  PASS
  FAIL
}

enum EvaluationScoreSource {
  GOOGLE
  MANUAL
}

model EvaluationForm {
  id                        String               @id @default(cuid())
  googleFormId              String               @unique
  googleFormTitle           String
  status                    EvaluationFormStatus @default(UNMAPPED)
  evaluationName            String?
  participantNameQuestionId String?
  participantEmailQuestionId String?
  useRespondentEmail        Boolean              @default(false)
  passingThreshold          Float                @default(80)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  questions                 EvaluationQuestion[]
  submissions               EvaluationSubmission[]

  @@index([status])
}

model EvaluationQuestion {
  id             String         @id @default(cuid())
  formId         String
  googleItemId   String
  title          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  form           EvaluationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers        EvaluationAnswer[]

  @@unique([formId, googleItemId])
  @@index([formId])
}

model EvaluationSubmission {
  id                       String                       @id @default(cuid())
  formId                   String
  googleResponseId         String
  submittedAt              DateTime
  respondentEmail          String?
  participantName          String?
  participantEmail         String?
  importedScore            Float?
  importedMaxScore         Float?
  finalScore               Float?
  finalMaxScore            Float?
  scoreSource              EvaluationScoreSource?
  workflowStatus           EvaluationSubmissionWorkflow @default(AWAITING_MAPPING)
  outcome                  EvaluationOutcome?
  thresholdSnapshot        Float?
  reviewerNotes            String?
  reviewedAt               DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  form                     EvaluationForm               @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers                  EvaluationAnswer[]

  @@unique([formId, googleResponseId])
  @@index([workflowStatus])
  @@index([outcome])
  @@index([submittedAt])
  @@index([participantName])
  @@index([participantEmail])
}

model EvaluationAnswer {
  id                    String               @id @default(cuid())
  submissionId          String
  questionId            String?
  googleItemId          String
  questionTitleSnapshot String
  answer                String
  score                 Float?
  maxScore              Float?
  createdAt             DateTime             @default(now())

  submission            EvaluationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question              EvaluationQuestion?  @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([googleItemId])
}
